# --- Server configuration ---
PORT=3000

# Secret used to sign auth tokens. MANDATORY in production — generate a long
# random string (e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))").
# If it is not set, the server generates a random one per boot (all sessions
# are invalidated at every restart). Never use the value below.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING
TOKEN_EXPIRY=7d

# --- Seed admin account (created on first launch) ---
ADMIN_EMAIL=admin@satv.dz
# Strong password required (min 12 chars). The server warns at boot if this
# is missing, too short, or the old default. Never use the value below.
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
ADMIN_NAME=Administrateur

# --- Public site URL (for OAuth redirects) ---
PUBLIC_URL=http://localhost:3000

# --- Google OAuth (create app at https://console.cloud.google.com) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Facebook OAuth (create app at https://developers.facebook.com) ---
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Auto-translation (MyMemory, free) ---
# Register a free email at https://mymemory.translated.net/ and put it here:
# the daily translation quota is MUCH higher with an email than anonymous.
MYMEMORY_EMAIL=